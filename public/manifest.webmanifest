{
  "name": "PersonalHub",
  "short_name": "PersonalHub",
  "description": "Tu espacio personal: finanzas, agenda, tareas y DevHub",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#76b900",
  "lang": "es",
  "dir": "ltr",
  "categories": ["productivity", "finance", "utilities"],
  "icons": [
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Agenda",
      "url": "/?tab=calendar",
      "description": "Abrir calendario y eventos"
    },
    {
      "name": "Tareas",
      "url": "/?tab=chores",
      "description": "Abrir tareas y recordatorios"
    }
  ]
}
